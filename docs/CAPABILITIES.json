  "not_proven": [
    "deployment: no hosted deployment is verified by this repository",
    "real clients: no real third-party MCP client session is verified",
    "backup/restore: database backup and restore are not exercised",
    "PublicMCPReady: the public release gate (scripts/public_mcp_gate.py) has not passed",
    "Supabase owner settings: email confirmation and CAPTCHA are not verified"
  ],
  "trial": {
    "endpoint": "/mcp-trial",
    "surface": "LI_DEPLOYMENT_SURFACE=mcp with LI_TRIAL_ENABLED=true (disabled by default)",
    "authentication": "none (anonymous); identity is never derived from session ids, tokens or arguments",
    "tools": [
      {
        "name": "trial_compare",
        "trial_only": true,
        "security_schemes": [
          {
            "type": "noauth"
          }
        ],
        "persists": false
      },
      {
        "name": "trial_research",
        "trial_only": true,
        "security_schemes": [
          {
            "type": "noauth"
          }
        ],
        "persists": false
      },
      {
        "name": "trial_verify_claim",
        "trial_only": true,
        "security_schemes": [
          {
            "type": "noauth"
          }
        ],
        "persists": false
      }
    ],
    "bounds": {
      "max_sources": 1,
      "max_records": 5,
      "max_pages": 1,
      "max_manifest_urls": 1,
      "max_request_bytes": 16384,
      "body_timeout_s": 5.0,
      "max_concurrent_calls": 2,
      "max_tasks": 8,
      "http_timeout_s": 10.0,
      "max_seconds": 40.0,
      "max_output_bytes": 256000,
      "max_estimated_usd": 2.0,
      "max_question_chars": 500,
      "max_query_chars": 200,
      "max_option_chars": 120,
      "max_options": 4
    },
    "abuse_controls": {
      "per_ip_requests_per_minute": 30,
      "global_requests_per_minute": 600,
      "per_ip_tool_calls_per_hour": 10,
      "spend_ceiling_usd_default": 10.0,
      "spend_window_seconds_default": 86400,
      "backend": "li_take_keyed_rate_limit (database); fail closed, no in-memory fallback"
    },
    "protected_tools": "refused with ACCOUNT_REQUIRED; connect an account at /mcp",
    "not_proven": [
      "real ChatGPT client: no ChatGPT connector installation or session against /mcp-trial has been performed"
    ]
  }
