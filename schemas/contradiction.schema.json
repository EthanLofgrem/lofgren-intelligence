      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "scope_note": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "severity": {
      "type": "number"
    },
    "id": {
      "type": "string"
    }
