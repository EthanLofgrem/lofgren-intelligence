{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofgren.enterprise/schemas/claim.schema.json",
  "title": "Claim",
  "description": "Claim(statement: 'str', origin: 'ClaimOrigin' = <ClaimOrigin.EXTRACTED: 'extracted'>, value: 'float | None' = None, unit: 'str' = '', polarity: 'int' = 1, supporting: 'list[str]' = <factory>, contradicting: 'list[str]' = <factory>, status: 'ClaimStatus' = <ClaimStatus.UNVERIFIED: 'unverified'>, confidence: 'float' = 0.0, topic: 'list[str]' = <factory>, question_id: 'str | None' = None, subject: 'str' = '', claim_type: 'ClaimType' = <ClaimType.GENERAL: 'general'>, scope: 'Scope' = <factory>, confidence_method: 'str' = 'v1-heuristic', sufficiency: 'str' = '', issues: 'list[str]' = <factory>, calculation_id: 'str | None' = None, question_ids: 'list[str]' = <factory>, identity_version: 'int' = 2, id: 'str' = '')",
  "type": "object",
  "properties": {
    "statement": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": [
        "extracted",
        "observed",
        "inferred",
        "user",
        "hypothesis"
      ]
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "type": "string"
    },
    "polarity": {
      "type": "integer"
    },
    "supporting": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradicting": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "unverified",
        "supported",
        "partially_verified",
        "verified",
        "contested",
        "insufficient_evidence"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "topic": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "question_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "type": "string"
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "attribution",
        "quantitative",
        "trend",
        "physical",
        "general"
      ]
    },
    "scope": {
      "$ref": "scope.schema.json"
    },
    "confidence_method": {
      "type": "string"
    },
    "sufficiency": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calculation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "question_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity_version": {
      "type": "integer"
    },
    "id": {
      "type": "string"
    }
  },
  "required": [
    "statement"
  ]
}
