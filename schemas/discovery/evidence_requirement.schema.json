{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofgren.enterprise/schemas/discovery/evidence_requirement.schema.json",
  "title": "EvidenceRequirement",
  "description": "What V1 would have to establish to test a hypothesis. V2 emits these; only V1 can satisfy them.",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "place": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "period": {
      "type": "array",
      "prefixItems": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "threshold": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "variable_units": {
      "type": "object"
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "version": {
      "const": "lofgren.discovery/1"
    },
    "id": {
      "type": "string"
    }
  },
  "required": [
    "description"
  ],
  "additionalProperties": false
}
