{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofgren.enterprise/schemas/discovery/uncertainty.schema.json",
  "title": "Uncertainty",
  "description": "Uncertainty(claim_id: 'str', statement: 'str', reason: 'UncertaintyReason', scope: 'Scope' = <factory>, confidence: 'float | None' = None, confidence_kind: 'ConfidenceKind' = <ConfidenceKind.CLAIM: 'claim'>, derived_from: 'list[str]' = <factory>, created_at: 'str' = <factory>, version: 'str' = 'lofgren.discovery/1', id: 'str' = '')",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "policy_unmet",
        "single_source",
        "insufficient",
        "stale",
        "contested"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence_kind": {
      "type": "string",
      "enum": [
        "evidence",
        "claim",
        "hypothesis",
        "simulation_uncertainty",
        "candidate_robustness",
        "outcome"
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "version": {
      "const": "lofgren.discovery/1"
    },
    "id": {
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "statement",
    "reason"
  ],
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "properties": {
        "valid_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "geography": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "lon": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
