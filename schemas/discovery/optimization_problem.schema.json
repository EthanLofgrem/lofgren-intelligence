{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lofgren.enterprise/schemas/discovery/optimization_problem.schema.json",
  "title": "OptimizationProblem",
  "description": "OptimizationProblem(variables: 'list[DecisionVariable]', objective: 'Expr', direction: 'str', constraints: 'list[Relation]' = <factory>, solver: 'str' = 'auto', derived_from: 'list[str]' = <factory>, created_at: 'str' = <factory>, version: 'str' = 'lofgren.discovery/1', id: 'str' = '')",
  "type": "object",
  "properties": {
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision_variable"
      }
    },
    "objective": {
      "$ref": "#/$defs/expr"
    },
    "direction": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "solver": {
      "type": "string"
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "version": {
      "const": "lofgren.discovery/1"
    },
    "id": {
      "type": "string"
    }
  },
  "required": [
    "variables",
    "objective",
    "direction"
  ],
  "additionalProperties": false,
  "$defs": {
    "decision_variable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "integer": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "expr": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "const"
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "var"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "add",
                "sub",
                "mul",
                "div",
                "min",
                "max"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "neg"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "pow"
            },
            "exponent": {
              "type": "integer"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "op",
            "args",
            "exponent"
          ],
          "additionalProperties": false
        }
      ]
    },
    "relation": {
      "type": "object",
      "properties": {
        "lhs": {
          "$ref": "#/$defs/expr"
        },
        "op": {
          "enum": [
            "<=",
            ">=",
            "=="
          ]
        },
        "rhs": {
          "$ref": "#/$defs/expr"
        }
      },
      "required": [
        "lhs",
        "op",
        "rhs"
      ],
      "additionalProperties": false
    }
  }
}
