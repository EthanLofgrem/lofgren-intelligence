# PREPARATION ONLY. Outside .github/workflows; not activated by publication.
# Owner environment ENABLED must be exactly true and SOURCE_SHA equal dispatched SHA.
name: selected-staging-worker-proof
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: li-one-selected-staging-worker-proof
  cancel-in-progress: false
jobs:
  proof:
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    if: ${{ vars.LI_STAGING_WORKER_PROOF_ENABLED == 'true' }}
    environment: li-staging-worker-proof
    steps:
      - name: Refuse unapproved invocation
        env:
          ACCEPTED_SHA: ${{ vars.LI_STAGING_WORKER_ACCEPTED_SHA }}
          UV_CHECKSUM: ${{ vars.LI_STAGING_UV_ARCHIVE_SHA256 }}
          ACTUAL_SHA: ${{ github.sha }}
          ACTUAL_REPO: ${{ github.repository }}
          REPO_PRIVATE: ${{ github.event.repository.private }}
          EVENT_NAME: ${{ github.event_name }}
        run: |
          python - <<'PY'
          import os,re,sys
          e=os.environ
          ok=(e['ACTUAL_REPO']=='EthanLofgrem/lofgren-intelligence'
              and e['REPO_PRIVATE']=='false' and e['EVENT_NAME']=='workflow_dispatch'
              and re.fullmatch('[0-9a-f]{40}',e['ACCEPTED_SHA'])
              and re.fullmatch('[0-9a-f]{64}',e['UV_CHECKSUM'])
              and e['ACTUAL_SHA']==e['ACCEPTED_SHA'])
          print('INVOCATION_ACCEPTED' if ok else 'INVOCATION_REFUSED')
          sys.exit(0 if ok else 1)
          PY
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.12'
      - uses: astral-sh/setup-uv@6b9c6063abd6010835644d4c2e1bef4cf5cd0fca # v6.0.1
        with:
          version: '0.6.17'
          checksum: ${{ vars.LI_STAGING_UV_ARCHIVE_SHA256 }}
          enable-cache: false
      - name: Frozen install without backend secret
        run: |
          uv sync --frozen --no-dev
      - name: One selected target, sanitized result
        env:
          SUPABASE_URL: ${{ vars.LI_STAGING_SUPABASE_URL }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.LI_STAGING_SUPABASE_SERVICE_ROLE_KEY }}
          PRIVATE_TARGET: ${{ secrets.LI_STAGING_WORKER_TARGET_JSON }}
          LI_RELEASE_SHA: ${{ github.sha }}
        run: |
          .venv/bin/python - <<'PY'
          import os,pathlib,subprocess,sys,tempfile
          p=None
          try:
              raw=os.environ.pop('PRIVATE_TARGET','').encode()
              if not raw or len(raw)>32768: raise ValueError()
              fd,name=tempfile.mkstemp(dir=os.environ['RUNNER_TEMP'])
              p=pathlib.Path(name)
              with os.fdopen(fd,'wb') as f: f.write(raw)
              os.chmod(p,0o600)
              code=subprocess.run([sys.executable,'-m','lofgren_intelligence.hosted.targeted_worker','--target',str(p)],timeout=110).returncode
          except Exception:
              print('BOUNDED_WORKER_FAIL');code=2
          finally:
              if p is not None: p.unlink(missing_ok=True)
          sys.exit(code)
          PY
